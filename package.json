{
  "name": "canirun",
  "version": "0.1.0",
  "description": "CLI to evaluate AI model compatibility on local hardware",
  "license": "MIT",
  "type": "commonjs",
  "bin": {
    "canirun": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "start": "node dist/cli.js",
    "lint": "tsc --noEmit",
    "postbuild": "chmod +x dist/cli.js"
  },
  "dependencies": {
    "@huggingface/hub": "^2.11.0",
    "chalk": "^4.1.2",
    "cli-table3": "^0.6.5",
    "commander": "^14.0.0",
    "dotenv": "^17.3.1",
    "p-limit": "^5.0.0",
    "systeminformation": "^5.31.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "tsx": "^4.21.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.0"
  }
}
